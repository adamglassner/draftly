<Window x:Class="Draftly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Draftly.Controls"
        Style="{StaticResource DraftlyWindow}"
        Title="Document - Draftly" Width="1180" Height="780" MinWidth="720" MinHeight="460"
        Icon="pack://application:,,,/Assets/draftly.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- tab row -->
            <RowDefinition Height="Auto"/>  <!-- ribbon -->
            <RowDefinition Height="Auto"/>  <!-- info bar -->
            <RowDefinition Height="Auto"/>  <!-- ruler -->
            <RowDefinition Height="*"/>     <!-- page -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ======================= TAB ROW ======================= -->
        <DockPanel Grid.Row="0" Background="{DynamicResource ChromeBg}" Margin="0,2,0,0" LastChildFill="False">
            <Button x:Name="FileButton" DockPanel.Dock="Left" Style="{StaticResource FileButton}" Content="File"
                    Click="FileButton_Click" ToolTip="New, open, save, print and settings"/>
            <RadioButton x:Name="TabHome" DockPanel.Dock="Left" Style="{StaticResource TabHeader}" Content="Home"
                         IsChecked="True" GroupName="RibbonTabs" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabView" DockPanel.Dock="Left" Style="{StaticResource TabHeader}" Content="View"
                         GroupName="RibbonTabs" Checked="Tab_Checked"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Click="Save_Click" ToolTip="Save (Ctrl+S)"/>
                <Button x:Name="QuickUndo" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="QuickRedo" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"/>
                <Rectangle Style="{StaticResource GroupDivider}" Margin="6,8"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings"/>
            </StackPanel>
        </DockPanel>

        <!-- ======================= RIBBON ======================= -->
        <Border Grid.Row="1" Background="{DynamicResource RibbonBg}" BorderBrush="{DynamicResource RibbonBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Margin="8,2,8,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Height="104" Margin="4,4,4,2">

                    <!-- ============ HOME ============ -->
                    <StackPanel x:Name="HomePanel" Orientation="Horizontal">

                        <!-- Clipboard -->
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Clipboard">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE77F;" Content="Paste"
                                        Click="Paste_Click" ToolTip="Paste (Ctrl+V)"/>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C6;" Content="Cut" Click="Cut_Click" ToolTip="Cut (Ctrl+X)"/>
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C8;" Content="Copy" Click="Copy_Click" ToolTip="Copy (Ctrl+C)"/>
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE77F;" Content="Paste special" Click="PasteSpecial_Click"
                                            ToolTip="Choose how to paste: formatted, plain text or picture (Ctrl+Alt+V)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <!-- Font -->
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Font">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ComboBox x:Name="FontFamilyBox" Width="170" IsEditable="True" IsTextSearchEnabled="True"
                                              MaxDropDownHeight="420" ToolTip="Font"
                                              SelectionChanged="FontFamilyBox_SelectionChanged"
                                              KeyDown="FontFamilyBox_KeyDown" LostKeyboardFocus="FontFamilyBox_LostFocus">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="15"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox x:Name="FontSizeBox" Width="68" Margin="4,0,0,0" IsEditable="True" ToolTip="Font size"
                                              SelectionChanged="FontSizeBox_SelectionChanged" KeyDown="FontSizeBox_KeyDown"
                                              LostKeyboardFocus="FontSizeBox_LostFocus"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E8;" Click="GrowFont_Click" ToolTip="Grow font (Ctrl+Shift+&gt;)"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E7;" Click="ShrinkFont_Click" ToolTip="Shrink font (Ctrl+Shift+&lt;)"/>
                                    <Button Style="{StaticResource IconButton}" Click="ClearFormatting_Click" ToolTip="Clear formatting (Ctrl+Space)">
                                        <Grid>
                                            <TextBlock Text="A" FontFamily="{DynamicResource UiFont}" FontSize="15" Margin="0,0,5,2"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource DangerText}"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BoldBtn" Style="{StaticResource IconToggle}" Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                                        <TextBlock Text="B" FontWeight="Bold" FontFamily="Georgia" FontSize="16"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ItalicBtn" Style="{StaticResource IconToggle}" Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="16"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource IconToggle}" Click="Underline_Click" ToolTip="Underline (Ctrl+U)">
                                        <TextBlock Text="U" TextDecorations="Underline" FontFamily="Georgia" FontSize="16"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="StrikeBtn" Style="{StaticResource IconToggle}" Click="Strike_Click" ToolTip="Strikethrough">
                                        <TextBlock Text="abc" TextDecorations="Strikethrough" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="SubBtn" Style="{StaticResource IconToggle}" Click="Subscript_Click" ToolTip="Subscript (Ctrl+=)">
                                        <TextBlock FontSize="14">x<Run Text="2" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                    </ToggleButton>
                                    <ToggleButton x:Name="SuperBtn" Style="{StaticResource IconToggle}" Click="Superscript_Click" ToolTip="Superscript (Ctrl+Shift+=)">
                                        <TextBlock FontSize="14">x<Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>
                                    </ToggleButton>
                                    <Rectangle Style="{StaticResource GroupDivider}" Margin="3,8"/>
                                    <!-- Text colour -->
                                    <Button Style="{StaticResource IconButton}" Click="TextColor_Click" ToolTip="Text colour">
                                        <Grid Width="18" Height="20">
                                            <TextBlock Text="A" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                            <Rectangle x:Name="TextColorSwatch" Height="4" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Fill="#C00000"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="TextColorDrop" Style="{StaticResource ChevronButton}" Click="TextColorDrop_Click" ToolTip="Choose text colour"/>
                                    <!-- Highlight -->
                                    <Button Style="{StaticResource IconButton}" Click="Highlight_Click" ToolTip="Highlight">
                                        <Grid Width="18" Height="20">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" FontSize="14" VerticalAlignment="Top"/>
                                            <Rectangle x:Name="HighlightSwatch" Height="4" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Fill="#FFF200"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="HighlightDrop" Style="{StaticResource ChevronButton}" Click="HighlightDrop_Click" ToolTip="Choose highlight colour"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <!-- Paragraph -->
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Paragraph">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Style="{StaticResource IconButton}" Click="IndentLess_Click" ToolTip="Decrease indent">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoIndentLess}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="IndentMore_Click" ToolTip="Increase indent">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoIndentMore}"/>
                                    </Button>
                                    <ToggleButton x:Name="BulletsBtn" Style="{StaticResource IconToggle}" Click="Bullets_Click" ToolTip="Bullets (Ctrl+Shift+L)"
                                                  FontFamily="{StaticResource IconFont}" Content="&#xE8FD;"/>
                                    <Button Style="{StaticResource ChevronButton}" Click="BulletsDrop_Click" ToolTip="Bullet style"/>
                                    <ToggleButton x:Name="NumberingBtn" Style="{StaticResource IconToggle}" Click="Numbering_Click" ToolTip="Numbering">
                                        <Grid Width="16" Height="17">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoNumberLines}"/>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="1" FontSize="6.5" LineHeight="5.3" LineStackingStrategy="BlockLineHeight"/>
                                                <TextBlock Text="2" FontSize="6.5" LineHeight="5.3" LineStackingStrategy="BlockLineHeight"/>
                                                <TextBlock Text="3" FontSize="6.5" LineHeight="5.3" LineStackingStrategy="BlockLineHeight"/>
                                            </StackPanel>
                                        </Grid>
                                    </ToggleButton>
                                    <Button Style="{StaticResource ChevronButton}" Click="NumberingDrop_Click" ToolTip="Numbering style"/>
                                    <Button x:Name="LineSpacingBtn" Style="{StaticResource IconButton}" Click="LineSpacing_Click" ToolTip="Line and paragraph spacing">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoLineSpacing}"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="AlignLeftBtn" Style="{StaticResource IconToggle}" Click="Align_Click" Tag="Left" ToolTip="Align left (Ctrl+L)">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoAlignLeft}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="AlignCenterBtn" Style="{StaticResource IconToggle}" Click="Align_Click" Tag="Center" ToolTip="Center (Ctrl+E)">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoAlignCenter}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="AlignRightBtn" Style="{StaticResource IconToggle}" Click="Align_Click" Tag="Right" ToolTip="Align right (Ctrl+R)">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoAlignRight}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="AlignJustifyBtn" Style="{StaticResource IconToggle}" Click="Align_Click" Tag="Justify" ToolTip="Justify (Ctrl+J)">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GeoJustify}"/>
                                    </ToggleButton>
                                    <Rectangle Style="{StaticResource GroupDivider}" Margin="3,8"/>
                                    <Button Style="{StaticResource IconButton}" Click="ParagraphDialog_Click" ToolTip="Paragraph settings">
                                        <TextBlock Text="¶" FontSize="17"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <!-- Insert -->
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Insert">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xEB9F;" Content="Picture" Click="InsertPicture_Click"
                                        ToolTip="Insert a picture from a file"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE787;" Content="Date and time" Click="InsertDateTime_Click"
                                        ToolTip="Insert the current date or time"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE710;" Content="Object" Click="InsertObject_Click"
                                        ToolTip="Insert a table, symbol, line, page break or another document"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <!-- Editing -->
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Editing">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE721;" Content="Find" Click="Find_Click" ToolTip="Find (Ctrl+F)"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8EE;" Content="Replace" Click="Replace_Click" ToolTip="Replace (Ctrl+H)"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8B3;" Content="Select all" Click="SelectAll_Click" ToolTip="Select all (Ctrl+A)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- ============ VIEW ============ -->
                    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Zoom">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A3;" Content="Zoom in" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+Plus)"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE71F;" Content="Zoom out" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+Minus)"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE71E;" Content="100%" Click="Zoom100_Click" ToolTip="Zoom to 100% (Ctrl+0)"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7C3;" Content="Page width" Click="ZoomPageWidth_Click" ToolTip="Fit the page width to the window"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Show or hide">
                            <StackPanel VerticalAlignment="Center">
                                <ToggleButton x:Name="ShowRulerBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xECC6;" Content="Ruler" Click="ShowRuler_Click"/>
                                <ToggleButton x:Name="ShowStatusBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xE8A1;" Content="Status bar" Click="ShowStatus_Click"/>
                                <ToggleButton x:Name="ShowMarksBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xE8D2;" Content="Formatting marks" Click="ShowMarks_Click"
                                              ToolTip="Show paragraph marks, spaces and tabs (Ctrl+Shift+8)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Settings">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Word wrap" Width="96" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="WrapBox" Width="160" SelectionChanged="WrapBox_SelectionChanged">
                                        <ComboBoxItem Content="No wrap"/>
                                        <ComboBoxItem Content="Wrap to window"/>
                                        <ComboBoxItem Content="Wrap to ruler"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Units" Width="96" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="UnitsBox" Width="160" SelectionChanged="UnitsBox_SelectionChanged">
                                        <ComboBoxItem Content="Inches"/>
                                        <ComboBoxItem Content="Centimeters"/>
                                        <ComboBoxItem Content="Points"/>
                                        <ComboBoxItem Content="Picas"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Theme">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ThemeLightBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xE706;" Content="Light"
                                              Click="Theme_Click" VerticalAlignment="Center" Height="Auto" Padding="10,10"/>
                                <ToggleButton x:Name="ThemeDarkBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xE708;" Content="Dark"
                                              Click="Theme_Click" VerticalAlignment="Center" Height="Auto" Padding="10,10"/>
                                <ToggleButton x:Name="ThemeSystemBtn" Style="{StaticResource RibbonSmallToggle}" Tag="&#xE7F4;" Content="Follow system"
                                              Click="Theme_Click" VerticalAlignment="Center" Height="Auto" Padding="10,10"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Rectangle Style="{StaticResource GroupDivider}"/>

                        <HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="More">
                            <Button Style="{StaticResource RibbonLarge}" Tag="&#xE713;" Content="All settings" Click="Settings_Click"/>
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ======================= INFO BAR ======================= -->
        <Border x:Name="InfoBar" Grid.Row="2" Visibility="Collapsed" Margin="8,0,8,6" CornerRadius="{StaticResource Radius}"
                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                        Content="&#xE711;" Click="InfoClose_Click" ToolTip="Dismiss"/>
                <Button x:Name="InfoAction" DockPanel.Dock="Right" Visibility="Collapsed" MinHeight="28" Padding="12,2"
                        Margin="8,0" Click="InfoAction_Click"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ======================= RULER ======================= -->
        <Border x:Name="RulerHost" Grid.Row="3" Background="{DynamicResource RulerMargin}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,1" ClipToBounds="True">
            <c:Ruler x:Name="Ruler" Height="26"/>
        </Border>

        <!-- ======================= PAGE ======================= -->
        <ScrollViewer x:Name="EditorScroll" Grid.Row="4" Background="{DynamicResource CanvasBg}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                      ScrollChanged="EditorScroll_ScrollChanged" SizeChanged="EditorScroll_SizeChanged"
                      PreviewMouseLeftButtonDown="EditorScroll_PreviewMouseLeftButtonDown">
            <Grid x:Name="PageHost" HorizontalAlignment="Center" Margin="24,20,24,40">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <!-- Shadow is a separate element so text never renders through a bitmap effect -->
                <Border x:Name="PageShadow" Background="{DynamicResource PageBg}" CornerRadius="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.22" Direction="270"/>
                    </Border.Effect>
                </Border>
                <AdornerDecorator ClipToBounds="False">
                    <Border x:Name="PageBorder" Background="{DynamicResource PageBg}" BorderBrush="{DynamicResource PageBorder}"
                            BorderThickness="0.5" CornerRadius="2">
                        <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Padding="0"
                                     AcceptsTab="True" AcceptsReturn="True" IsDocumentEnabled="False"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     Foreground="{DynamicResource PageText}" CaretBrush="{DynamicResource PageText}"
                                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.35"
                                     FocusVisualStyle="{x:Null}"
                                     SelectionChanged="Editor_SelectionChanged" TextChanged="Editor_TextChanged"
                                     PreviewMouseWheel="Editor_PreviewMouseWheel" PreviewKeyDown="Editor_PreviewKeyDown"
                                     ContextMenuOpening="Editor_ContextMenuOpening">
                            <RichTextBox.Template>
                                <!-- Bare template: no border, no inner scrolling. The outer ScrollViewer scrolls the page. -->
                                <ControlTemplate TargetType="RichTextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                                </ControlTemplate>
                            </RichTextBox.Template>
                            <RichTextBox.ContextMenu>
                                <ContextMenu x:Name="EditorMenu"/>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                    </Border>
                </AdornerDecorator>
            </Grid>
        </ScrollViewer>

        <!-- ======================= STATUS BAR ======================= -->
        <Border x:Name="StatusBar" Grid.Row="5" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomLabel" Style="{StaticResource FlatBase}" Content="100%" MinWidth="56" Click="Zoom100_Click"
                            ToolTip="Click to reset zoom to 100%"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE738;" Click="ZoomOut_Click" ToolTip="Zoom out"/>
                    <Slider x:Name="ZoomSlider" Width="150" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE710;" Click="ZoomIn_Click" ToolTip="Zoom in"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" TextBlock.FontSize="13" TextBlock.Foreground="{DynamicResource TextSecondary}">
                    <TextBlock x:Name="PageInfo" Text="Page 1 of 1" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock x:Name="LineInfo" Text="Line 1, Col 1" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="WordCountBtn" Style="{StaticResource FlatBase}" Click="WordCount_Click" ToolTip="Show detailed word count"
                            Foreground="{DynamicResource TextSecondary}" Padding="6,2" Margin="-6,0,14,0">
                        <TextBlock x:Name="WordInfo" Text="0 words"/>
                    </Button>
                    <TextBlock x:Name="FormatInfo" Text="Rich Text" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
